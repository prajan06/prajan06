<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales Report Generator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#4f46e5',
                        secondary: '#10b981',
                        dark: '#1e293b',
                        danger: '#ef4444',
                        warning: '#f59e0b',
                        info: '#3b82f6',
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans antialiased overflow-hidden">
    <div class="flex h-screen w-full">
        <!-- Sidebar -->
        <aside id="sidebar"
            class="w-64 bg-white shadow-lg flex flex-col fixed inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 z-20 transition-transform duration-300 ease-in-out">
            <div class="h-16 flex items-center justify-center border-b border-gray-100 flex-shrink-0">
                <h1 class="text-xl font-bold text-primary flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="bg-primary" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                    SalesGen
                </h1>
            </div>
            <nav class="flex-1 overflow-y-auto py-4 space-y-1 px-3" id="sidebar-nav">
                <!-- Navigation inserted by JS -->
            </nav>
            <div class="p-4 border-t border-gray-100 text-xs text-center text-gray-400">
                SalesGen v1.0 &copy; 2026
            </div>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col h-screen overflow-hidden w-full relative">
            <!-- Header -->
            <header
                class="h-16 bg-white shadow-[0_1px_2px_rgba(0,0,0,0.04)] flex items-center justify-between px-4 sm:px-6 z-10 flex-shrink-0">
                <div class="flex items-center">
                    <button id="mobile-menu-btn"
                        class="md:hidden text-gray-500 hover:text-gray-700 focus:outline-none p-2 rounded-md hover:bg-gray-100 mr-2">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4 6h16M4 12h16M4 18h16" />
                        </svg>
                    </button>
                    <h2 class="text-lg sm:text-xl font-semibold text-gray-800" id="page-title">Dashboard Overview</h2>
                </div>
                <div class="flex items-center gap-3">
                    <div class="text-sm font-medium text-gray-600 hidden sm:block">Admin User</div>
                    <div
                        class="w-8 h-8 rounded-full bg-gradient-to-r from-primary to-indigo-400 text-white flex items-center justify-center font-bold shadow-sm">
                        A
                    </div>
                </div>
            </header>

            <!-- Main Scrollable Area -->
            <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 relative bg-[#f8fafc]">

                <!-- Loading Overlay -->
                <div id="loading-overlay"
                    class="absolute inset-0 bg-white bg-opacity-70 z-50 flex items-center justify-center hidden backdrop-blur-sm transition-opacity">
                    <div class="flex flex-col items-center">
                        <div class="animate-spin rounded-full h-10 w-10 border-4 border-gray-200 border-t-primary">
                        </div>
                        <p class="mt-3 text-sm font-medium text-gray-600">Loading data...</p>
                    </div>
                </div>

                <!-- Alerts Container -->
                <div id="alerts-container" class="mb-6 space-y-3 empty:hidden"></div>

                <!-- Section: Summary -->
                <div id="section-summary" class="page-section hidden animate-fade-in">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6" id="summary-cards">
                        <!-- Summary Cards populated by JS -->
                    </div>
                </div>

                <!-- Section: All Sales -->
                <div id="section-all-sales" class="page-section hidden animate-fade-in">
                    <div
                        class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden flex flex-col h-[calc(100vh-140px)]">
                        <div
                            class="p-4 sm:p-5 border-b border-gray-100 flex flex-wrap gap-3 justify-between items-center bg-white">
                            <h3 class="text-lg font-semibold text-gray-800">Sales Register</h3>
                            <button onclick="fetchSales()"
                                class="text-sm bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 py-1.5 px-3 rounded-lg transition-colors flex items-center gap-1.5 font-medium shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none"
                                    viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                </svg>
                                Refresh Data
                            </button>
                        </div>
                        <div class="overflow-x-auto flex-1 h-full">
                            <table class="w-full text-left text-sm text-gray-600 min-w-[800px]">
                                <thead class="text-xs text-gray-500 uppercase bg-gray-50 sticky top-0 shadow-sm z-10">
                                    <tr>
                                        <th class="px-5 py-3.5 font-semibold">ID</th>
                                        <th class="px-5 py-3.5 font-semibold">Product</th>
                                        <th class="px-5 py-3.5 font-semibold">Category</th>
                                        <th class="px-5 py-3.5 font-semibold text-right">Qty</th>
                                        <th class="px-5 py-3.5 font-semibold text-right">Unit Price</th>
                                        <th class="px-5 py-3.5 font-semibold text-right">Total Value</th>
                                        <th class="px-5 py-3.5 font-semibold">Salesperson</th>
                                        <th class="px-5 py-3.5 font-semibold">Date</th>
                                    </tr>
                                </thead>
                                <tbody id="sales-table-body" class="divide-y divide-gray-100 bg-white">
                                    <!-- Rows populated by JS -->
                                </tbody>
                            </table>
                        </div>
                        <div id="sales-empty-state"
                            class="hidden py-12 flex flex-col items-center justify-center text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300 mb-3" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                            </svg>
                            <p class="text-base font-medium">No sales records found</p>
                            <p class="text-sm mt-1">Add a new sale to see it here.</p>
                        </div>
                    </div>
                </div>

                <!-- Section: Category Report -->
                <div id="section-category" class="page-section hidden animate-fade-in">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 sm:p-6 mb-6">
                        <div class="mb-5 flex justify-between items-center">
                            <h3 class="text-lg font-semibold text-gray-800">Revenue by Category</h3>
                        </div>
                        <div
                            class="h-[400px] w-full relative flex items-center justify-center bg-gray-50/50 rounded-lg p-2 border border-gray-50">
                            <canvas id="categoryChart"></canvas>
                            <div id="categoryChartEmpty"
                                class="hidden absolute inset-0 flex flex-col items-center justify-center text-gray-400">
                                <svg class="w-10 h-10 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                                    </path>
                                </svg>
                                <p>No data available to display chart</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section: Salesperson Report -->
                <div id="section-salesperson" class="page-section hidden animate-fade-in">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="p-5 border-b border-gray-100 bg-white">
                            <h3 class="text-lg font-semibold text-gray-800">Salesperson Performance</h3>
                        </div>
                        <div class="overflow-x-auto p-0">
                            <table class="w-full text-left text-sm text-gray-600">
                                <thead class="text-xs text-gray-500 uppercase bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-4 font-semibold">Salesperson Name</th>
                                        <th class="px-6 py-4 font-semibold text-center">Total Sales</th>
                                        <th class="px-6 py-4 font-semibold text-center">Total Quantity Sold</th>
                                        <th class="px-6 py-4 font-semibold text-right">Total Revenue</th>
                                    </tr>
                                </thead>
                                <tbody id="salesperson-table-body" class="divide-y divide-gray-100 bg-white">
                                    <!-- Populated by JS -->
                                </tbody>
                            </table>
                            <div id="salesperson-empty" class="hidden text-center py-8 text-gray-500">No performance
                                data available</div>
                        </div>
                    </div>
                </div>

                <!-- Section: Top Products -->
                <div id="section-top-products" class="page-section hidden animate-fade-in">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden max-w-4xl mx-auto">
                        <div class="p-5 border-b border-gray-100 bg-white flex items-center justify-between">
                            <h3 class="text-lg font-semibold text-gray-800 flex items-center gap-2">
                                <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                                    <path
                                        d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                                    </path>
                                </svg>
                                Top 5 Products by Revenue
                            </h3>
                        </div>
                        <ul id="top-products-list" class="divide-y divide-gray-100 bg-white p-2">
                            <!-- Populated by JS -->
                        </ul>
                        <div id="top-products-empty" class="hidden text-center py-12 text-gray-500">No product data
                            available</div>
                    </div>
                </div>

                <!-- Section: Add Sale -->
                <div id="section-add-sale" class="page-section hidden animate-fade-in">
                    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 md:p-8 max-w-2xl mx-auto">
                        <div class="mb-6 pb-4 border-b border-gray-100">
                            <h3 class="text-xl font-semibold text-gray-800">Add New Sale Record</h3>
                            <p class="text-gray-500 text-sm mt-1">Enter the details of the new transaction below.</p>
                        </div>
                        <form id="add-sale-form" class="space-y-5">
                            <div>
                                <label for="product_name" class="block mb-2 text-sm font-medium text-gray-700">Product
                                    Name</label>
                                <input type="text" id="product_name" name="product_name"
                                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-primary focus:border-primary block w-full p-2.5 transition-all outline-none"
                                    required placeholder="e.g. Wireless Headphones">
                            </div>
                            <div>
                                <label for="category"
                                    class="block mb-2 text-sm font-medium text-gray-700">Category</label>
                                <select id="category" name="category"
                                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-primary focus:border-primary block w-full p-2.5 transition-all outline-none"
                                    required>
                                    <option value="" disabled selected>Select category...</option>
                                    <option value="Electronics">Electronics</option>
                                    <option value="Clothing">Clothing</option>
                                    <option value="Books">Books</option>
                                    <option value="Home & Garden">Home & Garden</option>
                                    <option value="Toys">Toys</option>
                                    <option value="Sports">Sports</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label for="quantity"
                                        class="block mb-2 text-sm font-medium text-gray-700">Quantity</label>
                                    <input type="number" id="quantity" name="quantity" min="1"
                                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-primary focus:border-primary block w-full p-2.5 transition-all outline-none"
                                        required placeholder="1">
                                </div>
                                <div>
                                    <label for="unit_price" class="block mb-2 text-sm font-medium text-gray-700">Unit
                                        Price ($)</label>
                                    <div class="relative">
                                        <div
                                            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                            <span class="text-gray-500 sm:text-sm">$</span>
                                        </div>
                                        <input type="number" id="unit_price" name="unit_price" min="0.01" step="0.01"
                                            class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-primary focus:border-primary block w-full pl-8 p-2.5 transition-all outline-none"
                                            required placeholder="0.00">
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label for="salesperson"
                                    class="block mb-2 text-sm font-medium text-gray-700">Salesperson Name</label>
                                <input type="text" id="salesperson" name="salesperson"
                                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-primary focus:border-primary block w-full p-2.5 transition-all outline-none"
                                    required placeholder="e.g. John Doe">
                            </div>
                            <div class="pt-4">
                                <button type="submit"
                                    class="w-full text-white bg-primary hover:bg-indigo-600 focus:ring-4 focus:outline-none focus:ring-indigo-100 font-medium rounded-lg text-sm px-5 py-3 text-center shadow-md hover:shadow-lg transition-all flex justify-center items-center gap-2">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                                    </svg>
                                    Record Sale
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Section: Remove Sale -->
                <div id="section-remove-sale" class="page-section hidden animate-fade-in">
                    <div
                        class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 md:p-8 max-w-xl mx-auto border-t-4 border-t-danger">
                        <div class="text-center mb-6">
                            <div
                                class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                                <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-semibold text-gray-800">Remove Sale Record</h3>
                            <p class="text-sm text-gray-500 mt-2">Warning: This action is permanent and cannot be
                                undone.</p>
                        </div>
                        <form id="remove-sale-form" class="space-y-6">
                            <div>
                                <label for="delete_sale_id" class="block mb-2 text-sm font-medium text-gray-700">Sale ID
                                    to Remove</label>
                                <input type="text" id="delete_sale_id" name="delete_sale_id"
                                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-2 focus:ring-danger focus:border-danger block w-full p-3 transition-all outline-none text-center font-mono text-lg tracking-wider"
                                    placeholder="e.g. 1042" required autocomplete="off">
                            </div>
                            <div class="pt-2">
                                <button type="submit"
                                    class="w-full text-white bg-danger hover:bg-red-600 focus:ring-4 focus:outline-none focus:ring-red-100 font-medium rounded-lg text-sm px-5 py-3 text-center shadow-md hover:shadow-lg transition-all flex justify-center items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
                                        viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Permanently Delete
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <!-- Mobile Sidebar Backdrop -->
    <div id="mobile-backdrop"
        class="fixed inset-0 bg-gray-900 bg-opacity-50 z-10 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <script src="script.js"></script>
</body>

</html>
