# ------------------------------------------------------------
# 1. FEATURE EXTRACTION
# ------------------------------------------------------------

def extract_features(url):

    features = []

    # Add scheme if missing
    if not url.startswith(("http://", "https://")):
        test_url = "http://" + url
    else:
        test_url = url

    parsed = urlparse(test_url)

    hostname = parsed.netloc.lower()
    path = parsed.path

    # Remove port number
    hostname = hostname.split(":")[0]

    # Feature 1: URL length
    url_length = len(url)

    # Feature 2: Number of dots
    dot_count = url.count(".")

    # Feature 3: Number of hyphens
    hyphen_count = url.count("-")

    # Feature 4: Number of @ symbols
    at_count = url.count("@")

    # Feature 5: Number of ? symbols
    question_count = url.count("?")

    # Feature 6: Number of = symbols
    equal_count = url.count("=")

    # Feature 7: Number of & symbols
    ampersand_count = url.count("&")

    # Feature 8: Number of digits
    digit_count = sum(c.isdigit() for c in url)

    # Feature 9: Number of special characters
    special_count = len(re.findall(r"[^a-zA-Z0-9]", url))

    # Feature 10: HTTPS
    https = 1 if parsed.scheme == "https" else 0

    # Feature 11: IP address in URL
    ip_pattern = r"^(?:\d{1,3}\.){3}\d{1,3}$"
    has_ip = 1 if re.match(ip_pattern, hostname) else 0

    # Feature 12: Number of subdomains
    parts = hostname.split(".")
    subdomain_count = max(0, len(parts) - 2)

    # Feature 13: Suspicious words
    suspicious_words = [
        "login",
        "verify",
        "verification",
        "account",
        "update",
        "secure",
        "bank",
        "signin",
        "password",
        "confirm",
        "free",
        "bonus",
        "urgent"
    ]

    suspicious_word_count = sum(
        1 for word in suspicious_words
        if word in url.lower()
    )

    # Feature 14: URL entropy
    if len(url) > 0:
        frequency = {}

        for character in url:
            frequency[character] = frequency.get(character, 0) + 1

        entropy = 0

        for count in frequency.values():
            probability = count / len(url)
            entropy -= probability * math.log2(probability)
    else:
        entropy = 0

    features = [
        url_length,
        dot_count,
        hyphen_count,
        at_count,
        question_count,
        equal_count,
        ampersand_count,
        digit_count,
        special_count,
        https,
        has_ip,
        subdomain_count,
        suspicious_word_count,
        entropy
    ]

    return features


