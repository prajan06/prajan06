import tkinter as tk
import time

N = 8
cell_size = 60
delay = 0.5

board = [[0]*N for _ in range(N)]

# Check safe position
def is_safe(row, col):
    for i in range(row):
        if board[i][col] == 1:
            return False

    i, j = row-1, col-1
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1

    i, j = row-1, col+1
    while i >= 0 and j < N:
        if board[i][j] == 1:
            return False
        i -= 1
        j += 1

    return True

# Draw board with highlights
def draw_board(highlight=None, color="red"):
    canvas.delete("all")

    for i in range(N):
        for j in range(N):
            x1 = j * cell_size
            y1 = i * cell_size
            x2 = x1 + cell_size
            y2 = y1 + cell_size

            base_color = "white" if (i+j) % 2 == 0 else "gray"

            # Highlight invalid or valid cells
            if highlight and (i, j) == highlight:
                base_color = color

            canvas.create_rectangle(x1, y1, x2, y2, fill=base_color)

            if board[i][j] == 1:
                canvas.create_text(x1 + cell_size//2,
                                   y1 + cell_size//2,
                                   text="♛",
                                   font=("Arial", 28),
                                   fill="black")

    root.update()
    time.sleep(delay)

# Backtracking with visualization
def solve(row):
    if row == N:
        return True

    for col in range(N):

        # Show trying position
        if is_safe(row, col):
            draw_board((row, col), "green")  # ✅ safe
        else:
            draw_board((row, col), "red")    # ❌ unsafe

        if is_safe(row, col):
            board[row][col] = 1
            draw_board()

            if solve(row + 1):
                return True

            # Backtrack
            board[row][col] = 0
            draw_board()

    return False

# Start button
def start():
    solve(0)

# GUI setup
root = tk.Tk()
root.title("N-Queen Visualizer (With Explanation)")

canvas = tk.Canvas(root, width=N*cell_size, height=N*cell_size)
canvas.pack()

btn = tk.Button(root, text="Start", command=start)
btn.pack()

root.mainloop()
